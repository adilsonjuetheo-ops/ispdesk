DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=troque_por_algo_seguro_aqui_minimo_32_chars
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
META_APP_ID=seu_app_id
META_APP_SECRET=seu_app_secret
META_VERIFY_TOKEN=token_fixo_para_verificacao_webhook
PORT=3001
# Endereço público desta API. Usado para registrar o webhook de assinatura no
# D4Sign — sem ele o contrato é assinado mas o painel não fica sabendo.
API_PUBLIC_URL=https://api.seudominio.com.br
VAPID_EMAIL=admin@ispdesk.com.br
VAPID_PUBLIC_KEY=sua_chave_publica_vapid
VAPID_PRIVATE_KEY=sua_chave_privada_vapid

# Segurança das integrações SGP:
# Por padrão apenas HTTPS e endereços públicos são aceitos.
# Se um SGP legítimo estiver em rede privada, informe explicitamente o hostname.
SGP_ALLOWED_PRIVATE_HOSTS=
# Use somente durante migração de um SGP legado sem HTTPS.
SGP_ALLOW_HTTP=false
